import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

years = np.arange(2006, 2019)
Masters = [205.9, 208.6, 212.7, 220.5, 233.2, 242.4, 245.4, 241.4, 250.2, 255.7, 261.2, 267.9, 280.1]
Beer_consumption = [11402, 11492, 11450, 11502, 11474, 11480, 11452, 11484, 11555, 11601, 11731, 11862, 12048]  

plt.figure(figsize=(8, 4))

for i in range(len(years)):
    plt.scatter(Masters[i], Beer_consumption[i], color='blue')
    plt.text(Masters[i], Beer_consumption[i], str(years[i]), fontsize=9, ha='right', va='bottom')

plt.plot(np.unique(Masters), np.poly1d(np.polyfit(Masters, Beer_consumption, 1))(np.unique(Masters)))

x = np.unique(Masters)
plt.plot(x, m*x + b, label=f'y = {m:.2f}x + {b:.2f}')

plt.title('Masters vs Beer Consumption (2006-2018)')
plt.xlabel('Masters (in millions)')
plt.ylabel('Beer Consumption (in thousands of barrels)')
plt.legend()
plt.grid()
plt.show()
